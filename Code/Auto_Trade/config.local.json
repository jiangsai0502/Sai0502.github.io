{
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    // 必须和 TradingView 自动化 Pine 里的 Webhook secret 完全一致。
    "webhookSecret": "GodloveSai"
  },
  "strategy": {
    // 手动确认项：true 才会自动交易；测试/调代码时建议 false。
    "enabled": false,
    // 手动确认项：实际交易合约，换月时一定要改。
    "contract": "MGCM6",
    // 手动确认项：每次下单手数。
    "qty": 1,
    "maxSameDirectionTrades": 2,
    // 信号最大允许延迟，单位秒。Pine 已用 timenow，正常不需要太大。
    "maxSignalAgeSeconds": 60,
    "retryAttempts": 10,
    // 手动确认项：触发后停止新开仓。
    "dailyLossLimit": 300,
    // 手动确认项：达到后停止新开仓。
    "dailyProfitLimit": 600,
    // 手动确认项：连续亏损达到后停止新开仓。
    "maxConsecutiveLosses": 10,
    // 北京时间禁开仓开始小时。默认 04:00。
    "blockedStartHourBeijing": 4,
    // 北京时间禁开仓结束小时。默认 07:00。
    "blockedEndHourBeijing": 7,
    // 北京时间每日风控重置小时。默认 07:00。
    "resetHourBeijing": 7,
    "flattenScope": "account",
    // 下单后如果已经有持仓，会检查是否存在止损保护单。
    "bracketProtectionCheck": true,
    // 扩展状态轮询时持续检查是否有裸持仓。
    "unprotectedPositionCheck": true,
    // 无人值守建议 true：发现有持仓但没检测到止损单时，自动排队全平。
    "flattenUnprotectedPosition": true
  }
}
