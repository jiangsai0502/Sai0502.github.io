{
  "manifest_version": 3,
  "name": "Tradovate Manual Breakeven",
  "version": "0.1.0",
  "description": "Manual post-entry breakeven helper for TradingView Tradovate positions.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://*.tradovateapi.com/*"
  ],
  "action": {
    "default_title": "Manual Breakeven"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://*.tradingview.com/*"
      ]
    }
  ]
}
