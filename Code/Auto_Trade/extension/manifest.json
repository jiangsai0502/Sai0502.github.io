{
  "manifest_version": 3,
  "name": "MSS Local Executor",
  "version": "0.1.0",
  "description": "Executes MSS Local Bot tasks inside TradingView's Tradovate session.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://*.tradingview.com/*",
    "https://*.tradovateapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/*"
      ],
      "js": [
        "content/relay-client.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.tradingview.com/*"
      ],
      "js": [
        "page/tradovate-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
