//@version=5
indicator("MSS指标——App提醒功能（自适应结构）", overlay=true, max_lines_count=500, max_labels_count=500)

structureMode = input.string("自适应：大波动后包含内部结构", "结构范围模式", options=["只看外部结构", "包含内部结构", "自适应：大波动后包含内部结构"])
breakMode = input.string("宽松", "突破确认模式", options=["宽松", "严格"])
showBOS = input.bool(true, "显示 BOS（顺势结构突破）")
showMSS = input.bool(true, "显示 MSS（方向切换）")
enableAlerts = input.bool(true, "启用 App 警报")
showSwingLabels = input.bool(false, "显示内部摆点标签")

externalAtrLength = input.int(50, "外部结构 ATR 周期", minval=1)
externalSwingAtrMult = input.float(1.0, "外部结构最小摆动（ATR倍数）", minval=0.0, step=0.1)

enableImpulseReset = input.bool(true, "启用大波动自动重置外部结构")
impulseAtrLength = input.int(50, "大波动 ATR 周期", minval=1)
impulseAtrMult = input.float(2.0, "大波动判定（ATR倍数）", minval=0.1, step=0.1)
impulseMinBodyRatio = input.float(0.55, "大波动最小实体比例", minval=0.0, maxval=1.0, step=0.05)
internalBarsAfterImpulse = input.int(20, "大波动后包含内部结构根数", minval=1)

bullColor = input.color(color.lime, "多头突破线颜色")
bearColor = input.color(color.red, "空头突破线颜色")
internalLineTransparency = input.int(35, "内部结构线透明度", minval=0, maxval=100)

var float lastInternalSwingHigh = na
var int lastInternalSwingHighBar = na
var bool lastInternalSwingHighBroken = true
var float bullInternalWickExtreme = na

var float lastInternalSwingLow = na
var int lastInternalSwingLowBar = na
var bool lastInternalSwingLowBroken = true
var float bearInternalWickExtreme = na

var float lastExternalSwingHigh = na
var int lastExternalSwingHighBar = na
var bool lastExternalSwingHighBroken = true
var float bullExternalWickExtreme = na

var float lastExternalSwingLow = na
var int lastExternalSwingLowBar = na
var bool lastExternalSwingLowBroken = true
var float bearExternalWickExtreme = na

var float candidateSwingHigh = na
var float candidateSwingHighLow = na
var int candidateSwingHighBar = na

var float candidateSwingLow = na
var float candidateSwingLowHigh = na
var int candidateSwingLowBar = na

var bool pendingBullAlert = false
var bool pendingBullAlertWasMSS = false
var bool pendingBullAlertUseInternal = false
var float pendingBullAlertBreakClose = na
var int pendingBullAlertBreakBar = na
var string pendingBullAlertScope = ""

var bool pendingBearAlert = false
var bool pendingBearAlertWasMSS = false
var bool pendingBearAlertUseInternal = false
var float pendingBearAlertBreakClose = na
var int pendingBearAlertBreakBar = na
var string pendingBearAlertScope = ""

var int bias = 0
var int internalModeUntilBar = na

externalAtr = nz(ta.atr(externalAtrLength), ta.tr(true))
externalMinMove = externalAtr * externalSwingAtrMult

impulseAtr = nz(ta.atr(impulseAtrLength), ta.tr(true))
barRange = high - low
bodySize = math.abs(close - open)
bodyRatio = bodySize / math.max(barRange, syminfo.mintick)
isImpulseBar = enableImpulseReset and barRange >= impulseAtr * impulseAtrMult and bodyRatio >= impulseMinBodyRatio

modeIncludeInternal = structureMode == "包含内部结构"
modeAdaptive = structureMode == "自适应：大波动后包含内部结构"
adaptiveInternalActive = modeAdaptive and not na(internalModeUntilBar) and bar_index <= internalModeUntilBar
allowInternalBreaks = modeIncludeInternal or adaptiveInternalActive

newInternalSwingHigh = false
newInternalSwingLow = false
newExternalSwingHigh = false
newExternalSwingLow = false

if not na(candidateSwingHigh) and bar_index > candidateSwingHighBar and low < candidateSwingHighLow
    confirmedHigh = candidateSwingHigh
    confirmedHighBar = candidateSwingHighBar
    lastInternalSwingHigh := confirmedHigh
    lastInternalSwingHighBar := confirmedHighBar
    lastInternalSwingHighBroken := false
    bullInternalWickExtreme := na
    newInternalSwingHigh := true
    qualifiesAsExternalHigh = na(lastExternalSwingLow) or confirmedHigh - lastExternalSwingLow >= externalMinMove
    if qualifiesAsExternalHigh
        lastExternalSwingHigh := confirmedHigh
        lastExternalSwingHighBar := confirmedHighBar
        lastExternalSwingHighBroken := false
        bullExternalWickExtreme := na
        newExternalSwingHigh := true
    candidateSwingHigh := na
    candidateSwingHighLow := na
    candidateSwingHighBar := na

if not na(candidateSwingLow) and bar_index > candidateSwingLowBar and high > candidateSwingLowHigh
    confirmedLow = candidateSwingLow
    confirmedLowBar = candidateSwingLowBar
    lastInternalSwingLow := confirmedLow
    lastInternalSwingLowBar := confirmedLowBar
    lastInternalSwingLowBroken := false
    bearInternalWickExtreme := na
    newInternalSwingLow := true
    qualifiesAsExternalLow = na(lastExternalSwingHigh) or lastExternalSwingHigh - confirmedLow >= externalMinMove
    if qualifiesAsExternalLow
        lastExternalSwingLow := confirmedLow
        lastExternalSwingLowBar := confirmedLowBar
        lastExternalSwingLowBroken := false
        bearExternalWickExtreme := na
        newExternalSwingLow := true
    candidateSwingLow := na
    candidateSwingLowHigh := na
    candidateSwingLowBar := na

if high > high[1]
    candidateSwingHigh := high
    candidateSwingHighLow := low
    candidateSwingHighBar := bar_index

if low < low[1]
    candidateSwingLow := low
    candidateSwingLowHigh := high
    candidateSwingLowBar := bar_index

if showSwingLabels and newInternalSwingHigh
    label.new(lastInternalSwingHighBar, lastInternalSwingHigh, "内高", style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)

if showSwingLabels and newInternalSwingLow
    label.new(lastInternalSwingLowBar, lastInternalSwingLow, "内低", style=label.style_label_up, color=color.new(color.lime, 70), textcolor=color.white, size=size.tiny)

isStrictBreakMode = breakMode == "严格"

internalBullLooseBreak = not na(lastInternalSwingHigh) and not lastInternalSwingHighBroken and close > lastInternalSwingHigh
internalBearLooseBreak = not na(lastInternalSwingLow) and not lastInternalSwingLowBroken and close < lastInternalSwingLow
externalBullLooseBreak = not na(lastExternalSwingHigh) and not lastExternalSwingHighBroken and close > lastExternalSwingHigh
externalBearLooseBreak = not na(lastExternalSwingLow) and not lastExternalSwingLowBroken and close < lastExternalSwingLow

internalBullBreak = isStrictBreakMode ? internalBullLooseBreak and (na(bullInternalWickExtreme) or close > bullInternalWickExtreme) : internalBullLooseBreak
internalBearBreak = isStrictBreakMode ? internalBearLooseBreak and (na(bearInternalWickExtreme) or close < bearInternalWickExtreme) : internalBearLooseBreak
externalBullBreak = isStrictBreakMode ? externalBullLooseBreak and (na(bullExternalWickExtreme) or close > bullExternalWickExtreme) : externalBullLooseBreak
externalBearBreak = isStrictBreakMode ? externalBearLooseBreak and (na(bearExternalWickExtreme) or close < bearExternalWickExtreme) : externalBearLooseBreak

if not internalBullBreak and not na(lastInternalSwingHigh) and not lastInternalSwingHighBroken and high > lastInternalSwingHigh
    bullInternalWickExtreme := na(bullInternalWickExtreme) ? high : math.max(bullInternalWickExtreme, high)

if not internalBearBreak and not na(lastInternalSwingLow) and not lastInternalSwingLowBroken and low < lastInternalSwingLow
    bearInternalWickExtreme := na(bearInternalWickExtreme) ? low : math.min(bearInternalWickExtreme, low)

if not externalBullBreak and not na(lastExternalSwingHigh) and not lastExternalSwingHighBroken and high > lastExternalSwingHigh
    bullExternalWickExtreme := na(bullExternalWickExtreme) ? high : math.max(bullExternalWickExtreme, high)

if not externalBearBreak and not na(lastExternalSwingLow) and not lastExternalSwingLowBroken and low < lastExternalSwingLow
    bearExternalWickExtreme := na(bearExternalWickExtreme) ? low : math.min(bearExternalWickExtreme, low)

useExternalBullBreak = externalBullBreak
useInternalBullBreak = not useExternalBullBreak and allowInternalBreaks and internalBullBreak
useExternalBearBreak = externalBearBreak
useInternalBearBreak = not useExternalBearBreak and allowInternalBreaks and internalBearBreak

bullBreak = useExternalBullBreak or useInternalBullBreak
bearBreak = useExternalBearBreak or useInternalBearBreak
bullBreakUsesInternal = useInternalBullBreak
bearBreakUsesInternal = useInternalBearBreak
bullBreakScope = bullBreakUsesInternal ? "内部结构" : "外部结构"
bearBreakScope = bearBreakUsesInternal ? "内部结构" : "外部结构"
bullBreakLevel = bullBreakUsesInternal ? lastInternalSwingHigh : lastExternalSwingHigh
bearBreakLevel = bearBreakUsesInternal ? lastInternalSwingLow : lastExternalSwingLow
bullBreakLevelBar = bullBreakUsesInternal ? lastInternalSwingHighBar : lastExternalSwingHighBar
bearBreakLevelBar = bearBreakUsesInternal ? lastInternalSwingLowBar : lastExternalSwingLowBar

bullWasMSS = bullBreak and (bias == -1 or bias == 0)
bearWasMSS = bearBreak and (bias == 1 or bias == 0)
delayStrictAlert = isStrictBreakMode

bullImmediateAlert = enableAlerts and bullBreak and not delayStrictAlert
bearImmediateAlert = enableAlerts and bearBreak and not delayStrictAlert

bullDeferredAlert = enableAlerts and delayStrictAlert and pendingBullAlert and (pendingBullAlertUseInternal ? newInternalSwingHigh : newExternalSwingHigh) and bar_index > pendingBullAlertBreakBar
bearDeferredAlert = enableAlerts and delayStrictAlert and pendingBearAlert and (pendingBearAlertUseInternal ? newInternalSwingLow : newExternalSwingLow) and bar_index > pendingBearAlertBreakBar

bullDeferredAlertWasMSS = pendingBullAlertWasMSS
bearDeferredAlertWasMSS = pendingBearAlertWasMSS
bullDeferredAlertBreakClose = pendingBullAlertBreakClose
bearDeferredAlertBreakClose = pendingBearAlertBreakClose
bullDeferredAlertScope = pendingBullAlertScope
bearDeferredAlertScope = pendingBearAlertScope

alertBullBreak = bullImmediateAlert or bullDeferredAlert
alertBearBreak = bearImmediateAlert or bearDeferredAlert
alertAnyBreak = alertBullBreak or alertBearBreak
alertBullMSS = bullImmediateAlert ? bullWasMSS : bullDeferredAlert and bullDeferredAlertWasMSS
alertBearMSS = bearImmediateAlert ? bearWasMSS : bearDeferredAlert and bearDeferredAlertWasMSS

if bullDeferredAlert
    pendingBullAlert := false
    pendingBullAlertWasMSS := false
    pendingBullAlertUseInternal := false
    pendingBullAlertBreakClose := na
    pendingBullAlertBreakBar := na
    pendingBullAlertScope := ""

if bearDeferredAlert
    pendingBearAlert := false
    pendingBearAlertWasMSS := false
    pendingBearAlertUseInternal := false
    pendingBearAlertBreakClose := na
    pendingBearAlertBreakBar := na
    pendingBearAlertScope := ""

if internalBullBreak
    lastInternalSwingHighBroken := true
    bullInternalWickExtreme := na

if internalBearBreak
    lastInternalSwingLowBroken := true
    bearInternalWickExtreme := na

if externalBullBreak
    lastExternalSwingHighBroken := true
    bullExternalWickExtreme := na

if externalBearBreak
    lastExternalSwingLowBroken := true
    bearExternalWickExtreme := na

if bullBreak
    isMSS = bias == -1 or bias == 0
    shouldShow = isMSS ? showMSS : showBOS
    bias := 1
    if shouldShow
        line.new(bullBreakLevelBar, bullBreakLevel, bar_index, bullBreakLevel, color=bullBreakUsesInternal ? color.new(bullColor, internalLineTransparency) : bullColor, width=bullBreakUsesInternal ? 1 : 2, style=bullBreakUsesInternal ? line.style_dotted : line.style_solid)
    if delayStrictAlert
        pendingBullAlert := true
        pendingBullAlertWasMSS := isMSS
        pendingBullAlertUseInternal := bullBreakUsesInternal
        pendingBullAlertBreakClose := close
        pendingBullAlertBreakBar := bar_index
        pendingBullAlertScope := bullBreakScope
        pendingBearAlert := false

if bearBreak
    isMSS = bias == 1 or bias == 0
    shouldShow = isMSS ? showMSS : showBOS
    bias := -1
    if shouldShow
        line.new(bearBreakLevelBar, bearBreakLevel, bar_index, bearBreakLevel, color=bearBreakUsesInternal ? color.new(bearColor, internalLineTransparency) : bearColor, width=bearBreakUsesInternal ? 1 : 2, style=bearBreakUsesInternal ? line.style_dotted : line.style_solid)
    if delayStrictAlert
        pendingBearAlert := true
        pendingBearAlertWasMSS := isMSS
        pendingBearAlertUseInternal := bearBreakUsesInternal
        pendingBearAlertBreakClose := close
        pendingBearAlertBreakBar := bar_index
        pendingBearAlertScope := bearBreakScope
        pendingBullAlert := false

if isImpulseBar
    lastExternalSwingHigh := high
    lastExternalSwingHighBar := bar_index
    lastExternalSwingHighBroken := false
    bullExternalWickExtreme := na
    lastExternalSwingLow := low
    lastExternalSwingLowBar := bar_index
    lastExternalSwingLowBroken := false
    bearExternalWickExtreme := na
    internalModeUntilBar := bar_index + internalBarsAfterImpulse
    bias := close >= open ? 1 : -1

if alertBullBreak
    wasMSS = bullImmediateAlert ? bullWasMSS : bullDeferredAlertWasMSS
    breakClose = bullImmediateAlert ? close : bullDeferredAlertBreakClose
    scopeText = bullImmediateAlert ? bullBreakScope : bullDeferredAlertScope
    msg = (wasMSS ? "Bullish MSS" : "Bullish BOS") + " [" + scopeText + "] on " + syminfo.ticker + ". Break close: " + str.tostring(breakClose) + ". Current close: " + str.tostring(close) + ". Timeframe: " + timeframe.period + "."
    if bullDeferredAlert
        alert(msg, alert.freq_once_per_bar)
    else
        alert(msg, alert.freq_once_per_bar_close)

if alertBearBreak
    wasMSS = bearImmediateAlert ? bearWasMSS : bearDeferredAlertWasMSS
    breakClose = bearImmediateAlert ? close : bearDeferredAlertBreakClose
    scopeText = bearImmediateAlert ? bearBreakScope : bearDeferredAlertScope
    msg = (wasMSS ? "Bearish MSS" : "Bearish BOS") + " [" + scopeText + "] on " + syminfo.ticker + ". Break close: " + str.tostring(breakClose) + ". Current close: " + str.tostring(close) + ". Timeframe: " + timeframe.period + "."
    if bearDeferredAlert
        alert(msg, alert.freq_once_per_bar)
    else
        alert(msg, alert.freq_once_per_bar_close)

alertcondition(alertAnyBreak, "任意结构突破", "Structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBullBreak, "多头结构突破", "Bullish structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBearBreak, "空头结构突破", "Bearish structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBullMSS, "多头 MSS", "Bullish MSS on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBearMSS, "空头 MSS", "Bearish MSS on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
