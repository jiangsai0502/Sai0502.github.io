//@version=5
indicator("MSS指标——ICT层级结构提醒（递推转移实验版）", overlay=true, max_lines_count=500, max_labels_count=500)

alertLevel = input.string("Level 2 ITH/ITL", "App提醒使用层级", options=["Level 1 STH/STL", "Level 2 ITH/ITL", "Level 1 + Level 2"])
showLevel1Points = input.bool(true, "显示 Level 1 短期点 STH/STL")
showLevel2Points = input.bool(true, "显示 Level 2 中期点 ITH/ITL")
showLevel1BOS = input.bool(true, "显示 Level 1 结构突破细线")
showLevel2BOS = input.bool(true, "显示 Level 2 结构突破粗线")
showBOS = input.bool(true, "显示 BOS（顺势结构突破）")
showMSS = input.bool(true, "显示 MSS（方向切换）")
enableRecursiveTransfer = input.bool(true, "启用内部突破线递推转移")
maxRecursiveTransfers = input.int(3, "单次最多递推层数", minval=1, maxval=10)

bullColor = input.color(color.lime, "多头突破线颜色")
bearColor = input.color(color.red, "空头突破线颜色")
level1Color = input.color(color.new(color.gray, 15), "Level 1 点颜色")
level2Color = input.color(color.new(color.yellow, 0), "Level 2 点颜色")

var array<float> effectiveHighs = array.new<float>()
var array<float> effectiveLows = array.new<float>()
var array<int> effectiveBars = array.new<int>()
var array<int> effectiveTimes = array.new<int>()

var array<float> sthValues = array.new<float>()
var array<int> sthBars = array.new<int>()
var array<int> sthTimes = array.new<int>()
var array<float> stlValues = array.new<float>()
var array<int> stlBars = array.new<int>()
var array<int> stlTimes = array.new<int>()

var float motherHigh = na
var float motherLow = na

var float activeSTH = na
var int activeSTHBar = na
var int activeSTHTime = na
var float activeSTHLine = na
var int activeSTHLineTime = na
var bool activeSTHBroken = true
var bool activeSTHIsL2 = false
var float activeSTL = na
var int activeSTLBar = na
var int activeSTLTime = na
var float activeSTLLine = na
var int activeSTLLineTime = na
var bool activeSTLBroken = true
var bool activeSTLIsL2 = false

var float activeITH = na
var int activeITHBar = na
var int activeITHTime = na
var bool activeITHBroken = true
var float activeITL = na
var int activeITLBar = na
var int activeITLTime = na
var bool activeITLBroken = true

var float highestValidHigh = na
var int highestValidHighBar = na
var int highestValidHighTime = na
var float highestValidHighLine = na
var int highestValidHighLineTime = na
var bool highestValidHighBroken = true
var float lowestValidLow = na
var int lowestValidLowBar = na
var int lowestValidLowTime = na
var float lowestValidLowLine = na
var int lowestValidLowLineTime = na
var bool lowestValidLowBroken = true

var int biasL1 = 0
var int biasL2 = 0

var bool pendingBullL1 = false
var bool pendingBullL1WasMSS = false
var float pendingBullL1BreakClose = na
var float pendingBullL1Level = na
var int pendingBullL1BreakBar = na

var bool pendingBearL1 = false
var bool pendingBearL1WasMSS = false
var float pendingBearL1BreakClose = na
var float pendingBearL1Level = na
var int pendingBearL1BreakBar = na

var bool pendingBullL2 = false
var bool pendingBullL2WasMSS = false
var float pendingBullL2BreakClose = na
var float pendingBullL2Level = na
var int pendingBullL2BreakBar = na

var bool pendingBearL2 = false
var bool pendingBearL2WasMSS = false
var float pendingBearL2BreakClose = na
var float pendingBearL2Level = na
var int pendingBearL2BreakBar = na

var line bullRecursiveLine = na
var bool bullRecursiveActive = false
var float bullRecursiveLevel = na
var int bullRecursiveTime = na
var int bullRecursiveMoveCount = 0

var line bearRecursiveLine = na
var bool bearRecursiveActive = false
var float bearRecursiveLevel = na
var int bearRecursiveTime = na
var int bearRecursiveMoveCount = 0

f_confirm_low(array<float> values, array<int> bars, array<int> times) =>
    bool ok = false
    float price = na
    int pointBar = na
    int pointTime = na
    int n = array.size(values)
    if n >= 3
        float left = array.get(values, n - 3)
        float mid = array.get(values, n - 2)
        float right = array.get(values, n - 1)
        if left > mid and right > mid
            ok := true
            price := mid
            pointBar := array.get(bars, n - 2)
            pointTime := array.get(times, n - 2)
    [ok, price, pointBar, pointTime]

f_confirm_high(array<float> values, array<int> bars, array<int> times) =>
    bool ok = false
    float price = na
    int pointBar = na
    int pointTime = na
    int n = array.size(values)
    if n >= 3
        float left = array.get(values, n - 3)
        float mid = array.get(values, n - 2)
        float right = array.get(values, n - 1)
        if left < mid and right < mid
            ok := true
            price := mid
            pointBar := array.get(bars, n - 2)
            pointTime := array.get(times, n - 2)
    [ok, price, pointBar, pointTime]

f_next_outer_high(currentTime, currentPrice) =>
    bool found = false
    float price = na
    int pointTime = na
    int n = array.size(sthValues)
    if n > 0
        for offset = 0 to n - 1
            int idx = n - 1 - offset
            float candidatePrice = array.get(sthValues, idx)
            int candidateTime = array.get(sthTimes, idx)
            if candidateTime < currentTime and candidatePrice > currentPrice
                found := true
                price := candidatePrice
                pointTime := candidateTime
                break
    [found, price, pointTime]

f_next_outer_low(currentTime, currentPrice) =>
    bool found = false
    float price = na
    int pointTime = na
    int n = array.size(stlValues)
    if n > 0
        for offset = 0 to n - 1
            int idx = n - 1 - offset
            float candidatePrice = array.get(stlValues, idx)
            int candidateTime = array.get(stlTimes, idx)
            if candidateTime < currentTime and candidatePrice < currentPrice
                found := true
                price := candidatePrice
                pointTime := candidateTime
                break
    [found, price, pointTime]

f_mark(pointTime, price, labelText, bgColor, markerStyle, showMarker) =>
    if showMarker
        label.new(pointTime, price, labelText, xloc=xloc.bar_time, style=markerStyle, color=bgColor, textcolor=color.black, size=size.tiny)

f_alert_message(directionText, breakTypeText, levelText, breakLevel, breakClose) =>
    directionText + " " + breakTypeText + " [" + levelText + "] pullback started on " + syminfo.ticker + ". Break level: " + str.tostring(breakLevel) + ". Break close: " + str.tostring(breakClose) + ". Current close: " + str.tostring(close) + ". Timeframe: " + timeframe.period + "."

alertL1Enabled = alertLevel == "Level 1 STH/STL" or alertLevel == "Level 1 + Level 2"
alertL2Enabled = alertLevel == "Level 2 ITH/ITL" or alertLevel == "Level 1 + Level 2"

newEffectiveBar = false

if na(motherHigh)
    motherHigh := high
    motherLow := low
    array.push(effectiveHighs, high)
    array.push(effectiveLows, low)
    array.push(effectiveBars, bar_index)
    array.push(effectiveTimes, time)
    newEffectiveBar := true
else
    if not (high <= motherHigh and low >= motherLow)
        motherHigh := high
        motherLow := low
        array.push(effectiveHighs, high)
        array.push(effectiveLows, low)
        array.push(effectiveBars, bar_index)
        array.push(effectiveTimes, time)
        newEffectiveBar := true

newSTH = false
newSTL = false

if newEffectiveBar
    int n = array.size(effectiveBars)
    if n >= 3
        float leftHigh = array.get(effectiveHighs, n - 3)
        float midHigh = array.get(effectiveHighs, n - 2)
        float rightHigh = array.get(effectiveHighs, n - 1)
        float leftLow = array.get(effectiveLows, n - 3)
        float midLow = array.get(effectiveLows, n - 2)
        float rightLow = array.get(effectiveLows, n - 1)
        int midBar = array.get(effectiveBars, n - 2)
        int midTime = array.get(effectiveTimes, n - 2)

        if midHigh > leftHigh and midHigh > rightHigh
            newSTH := true
            array.push(sthValues, midHigh)
            array.push(sthBars, midBar)
            array.push(sthTimes, midTime)
            activeSTH := midHigh
            activeSTHBar := midBar
            activeSTHTime := midTime
            activeSTHLine := midHigh
            activeSTHLineTime := midTime
            activeSTHBroken := false
            activeSTHIsL2 := false
            f_mark(midTime, midHigh, "STH", level1Color, label.style_label_down, showLevel1Points)
            if not na(activeITH) and activeSTH >= activeITH
                highestValidHigh := activeSTH
                highestValidHighBar := activeSTHBar
                highestValidHighTime := activeSTHTime
                highestValidHighLine := activeSTHLine
                highestValidHighLineTime := activeSTHLineTime
                highestValidHighBroken := false
                activeSTHIsL2 := true
            [confirmedITH, ithPrice, ithBar, ithTime] = f_confirm_high(sthValues, sthBars, sthTimes)
            if confirmedITH
                activeITH := ithPrice
                activeITHBar := ithBar
                activeITHTime := ithTime
                activeITHBroken := false
                f_mark(ithTime, ithPrice, "ITH", level2Color, label.style_label_down, showLevel2Points)
                if not na(activeSTH) and not activeSTHBroken and activeSTH >= activeITH
                    highestValidHigh := activeSTH
                    highestValidHighBar := activeSTHBar
                    highestValidHighTime := activeSTHTime
                    highestValidHighLine := activeSTHLine
                    highestValidHighLineTime := activeSTHLineTime
                    highestValidHighBroken := false
                    activeSTHIsL2 := true
                else
                    highestValidHigh := activeITH
                    highestValidHighBar := activeITHBar
                    highestValidHighTime := activeITHTime
                    highestValidHighLine := activeITH
                    highestValidHighLineTime := activeITHTime
                    highestValidHighBroken := false
                    activeSTHIsL2 := false

        if midLow < leftLow and midLow < rightLow
            newSTL := true
            array.push(stlValues, midLow)
            array.push(stlBars, midBar)
            array.push(stlTimes, midTime)
            activeSTL := midLow
            activeSTLBar := midBar
            activeSTLTime := midTime
            activeSTLLine := midLow
            activeSTLLineTime := midTime
            activeSTLBroken := false
            activeSTLIsL2 := false
            f_mark(midTime, midLow, "STL", level1Color, label.style_label_up, showLevel1Points)
            if not na(activeITL) and activeSTL <= activeITL
                lowestValidLow := activeSTL
                lowestValidLowBar := activeSTLBar
                lowestValidLowTime := activeSTLTime
                lowestValidLowLine := activeSTLLine
                lowestValidLowLineTime := activeSTLLineTime
                lowestValidLowBroken := false
                activeSTLIsL2 := true
            [confirmedITL, itlPrice, itlBar, itlTime] = f_confirm_low(stlValues, stlBars, stlTimes)
            if confirmedITL
                activeITL := itlPrice
                activeITLBar := itlBar
                activeITLTime := itlTime
                activeITLBroken := false
                f_mark(itlTime, itlPrice, "ITL", level2Color, label.style_label_up, showLevel2Points)
                if not na(activeSTL) and not activeSTLBroken and activeSTL <= activeITL
                    lowestValidLow := activeSTL
                    lowestValidLowBar := activeSTLBar
                    lowestValidLowTime := activeSTLTime
                    lowestValidLowLine := activeSTLLine
                    lowestValidLowLineTime := activeSTLLineTime
                    lowestValidLowBroken := false
                    activeSTLIsL2 := true
                else
                    lowestValidLow := activeITL
                    lowestValidLowBar := activeITLBar
                    lowestValidLowTime := activeITLTime
                    lowestValidLowLine := activeITL
                    lowestValidLowLineTime := activeITLTime
                    lowestValidLowBroken := false
                    activeSTLIsL2 := false

if not na(activeSTH) and not activeSTHBroken and high > activeSTH and close <= activeSTH
    activeSTH := high
    activeSTHBar := bar_index
    activeSTHTime := time
    if not na(activeITH) and activeSTH > activeITH
        highestValidHigh := activeSTH
        highestValidHighBar := activeSTHBar
        highestValidHighTime := activeSTHTime
        highestValidHighLine := activeSTHLine
        highestValidHighLineTime := activeSTHLineTime
        highestValidHighBroken := false
        activeSTHIsL2 := true

if not na(activeSTL) and not activeSTLBroken and low < activeSTL and close >= activeSTL
    activeSTL := low
    activeSTLBar := bar_index
    activeSTLTime := time
    if not na(activeITL) and activeSTL < activeITL
        lowestValidLow := activeSTL
        lowestValidLowBar := activeSTLBar
        lowestValidLowTime := activeSTLTime
        lowestValidLowLine := activeSTLLine
        lowestValidLowLineTime := activeSTLLineTime
        lowestValidLowBroken := false
        activeSTLIsL2 := true

if not na(highestValidHigh) and not highestValidHighBroken and high > highestValidHigh and close <= highestValidHigh
    highestValidHigh := high
    highestValidHighBar := bar_index
    highestValidHighTime := time

if not na(lowestValidLow) and not lowestValidLowBroken and low < lowestValidLow and close >= lowestValidLow
    lowestValidLow := low
    lowestValidLowBar := bar_index
    lowestValidLowTime := time

bullPullbackL1 = alertL1Enabled and pendingBullL1 and newSTH and bar_index > pendingBullL1BreakBar
bearPullbackL1 = alertL1Enabled and pendingBearL1 and newSTL and bar_index > pendingBearL1BreakBar
bullPullbackL2 = alertL2Enabled and pendingBullL2 and newSTH and bar_index > pendingBullL2BreakBar
bearPullbackL2 = alertL2Enabled and pendingBearL2 and newSTL and bar_index > pendingBearL2BreakBar

if bullPullbackL1
    alert(f_alert_message("Bullish", pendingBullL1WasMSS ? "MSS" : "BOS", "Level 1 STH/STL", pendingBullL1Level, pendingBullL1BreakClose), alert.freq_once_per_bar)
    pendingBullL1 := false

if bearPullbackL1
    alert(f_alert_message("Bearish", pendingBearL1WasMSS ? "MSS" : "BOS", "Level 1 STH/STL", pendingBearL1Level, pendingBearL1BreakClose), alert.freq_once_per_bar)
    pendingBearL1 := false

if bullPullbackL2
    alert(f_alert_message("Bullish", pendingBullL2WasMSS ? "MSS" : "BOS", "Level 2 ITH/ITL", pendingBullL2Level, pendingBullL2BreakClose), alert.freq_once_per_bar)
    pendingBullL2 := false

if bearPullbackL2
    alert(f_alert_message("Bearish", pendingBearL2WasMSS ? "MSS" : "BOS", "Level 2 ITH/ITL", pendingBearL2Level, pendingBearL2BreakClose), alert.freq_once_per_bar)
    pendingBearL2 := false

bullL1IsL2Source = not na(highestValidHighLine) and not highestValidHighBroken and activeSTHLine == highestValidHighLine and activeSTHLineTime == highestValidHighLineTime
bearL1IsL2Source = not na(lowestValidLowLine) and not lowestValidLowBroken and activeSTLLine == lowestValidLowLine and activeSTLLineTime == lowestValidLowLineTime
bullBreakL2 = not na(highestValidHigh) and not highestValidHighBroken and close > highestValidHigh
bearBreakL2 = not na(lowestValidLow) and not lowestValidLowBroken and close < lowestValidLow
bullBreakL1 = not bullBreakL2 and not bullL1IsL2Source and not activeSTHIsL2 and not na(activeSTH) and not activeSTHBroken and close > activeSTH and (na(highestValidHigh) or activeSTH < highestValidHigh)
bearBreakL1 = not bearBreakL2 and not bearL1IsL2Source and not activeSTLIsL2 and not na(activeSTL) and not activeSTLBroken and close < activeSTL and (na(lowestValidLow) or activeSTL > lowestValidLow)

if bullBreakL1
    isMSS = biasL1 == -1 or biasL1 == 0
    shouldShow = isMSS ? showMSS : showBOS
    activeSTHBroken := true
    biasL1 := 1
    bullRecursiveLine := na
    if showLevel1BOS and shouldShow
        bullRecursiveLine := line.new(activeSTHLineTime, activeSTHLine, time, activeSTHLine, xloc=xloc.bar_time, color=color.new(bullColor, 20), width=1)
    bullRecursiveActive := true
    bullRecursiveLevel := activeSTHLine
    bullRecursiveTime := activeSTHLineTime
    bullRecursiveMoveCount := 0
    bearRecursiveActive := false
    if alertL1Enabled
        pendingBullL1 := true
        pendingBullL1WasMSS := isMSS
        pendingBullL1BreakClose := close
        pendingBullL1Level := activeSTH
        pendingBullL1BreakBar := bar_index
        pendingBearL1 := false

if bearBreakL1
    isMSS = biasL1 == 1 or biasL1 == 0
    shouldShow = isMSS ? showMSS : showBOS
    activeSTLBroken := true
    biasL1 := -1
    bearRecursiveLine := na
    if showLevel1BOS and shouldShow
        bearRecursiveLine := line.new(activeSTLLineTime, activeSTLLine, time, activeSTLLine, xloc=xloc.bar_time, color=color.new(bearColor, 20), width=1)
    bearRecursiveActive := true
    bearRecursiveLevel := activeSTLLine
    bearRecursiveTime := activeSTLLineTime
    bearRecursiveMoveCount := 0
    bullRecursiveActive := false
    if alertL1Enabled
        pendingBearL1 := true
        pendingBearL1WasMSS := isMSS
        pendingBearL1BreakClose := close
        pendingBearL1Level := activeSTL
        pendingBearL1BreakBar := bar_index
        pendingBullL1 := false

if bullBreakL2
    isMSS = biasL2 == -1 or biasL2 == 0
    shouldShow = isMSS ? showMSS : showBOS
    highestValidHighBroken := true
    if not na(activeSTH) and close > activeSTH
        activeSTHBroken := true
        activeSTHIsL2 := false
    if not na(activeITH) and close > activeITH
        activeITHBroken := true
    biasL2 := 1
    bullL2ExtendsRecursive = enableRecursiveTransfer and bullRecursiveActive and not na(bullRecursiveLine) and not na(bullRecursiveTime) and not na(bullRecursiveLevel) and highestValidHighLineTime < bullRecursiveTime and highestValidHighLine > bullRecursiveLevel
    if bullL2ExtendsRecursive
        line.delete(bullRecursiveLine)
        bullRecursiveLine := na
    bullRecursiveLine := na
    if showLevel2BOS and shouldShow
        bullRecursiveLine := line.new(highestValidHighLineTime, highestValidHighLine, time, highestValidHighLine, xloc=xloc.bar_time, color=bullColor, width=3)
    bullRecursiveActive := true
    bullRecursiveLevel := highestValidHighLine
    bullRecursiveTime := highestValidHighLineTime
    bullRecursiveMoveCount := 0
    bearRecursiveActive := false
    if bullL2ExtendsRecursive
        pendingBullL1 := false
    if alertL2Enabled
        pendingBullL2 := true
        pendingBullL2WasMSS := isMSS
        pendingBullL2BreakClose := close
        pendingBullL2Level := highestValidHigh
        pendingBullL2BreakBar := bar_index
        pendingBearL2 := false

if bearBreakL2
    isMSS = biasL2 == 1 or biasL2 == 0
    shouldShow = isMSS ? showMSS : showBOS
    lowestValidLowBroken := true
    if not na(activeSTL) and close < activeSTL
        activeSTLBroken := true
        activeSTLIsL2 := false
    if not na(activeITL) and close < activeITL
        activeITLBroken := true
    biasL2 := -1
    bearL2ExtendsRecursive = enableRecursiveTransfer and bearRecursiveActive and not na(bearRecursiveLine) and not na(bearRecursiveTime) and not na(bearRecursiveLevel) and lowestValidLowLineTime < bearRecursiveTime and lowestValidLowLine < bearRecursiveLevel
    if bearL2ExtendsRecursive
        line.delete(bearRecursiveLine)
        bearRecursiveLine := na
    bearRecursiveLine := na
    if showLevel2BOS and shouldShow
        bearRecursiveLine := line.new(lowestValidLowLineTime, lowestValidLowLine, time, lowestValidLowLine, xloc=xloc.bar_time, color=bearColor, width=3)
    bearRecursiveActive := true
    bearRecursiveLevel := lowestValidLowLine
    bearRecursiveTime := lowestValidLowLineTime
    bearRecursiveMoveCount := 0
    bullRecursiveActive := false
    if bearL2ExtendsRecursive
        pendingBearL1 := false
    if alertL2Enabled
        pendingBearL2 := true
        pendingBearL2WasMSS := isMSS
        pendingBearL2BreakClose := close
        pendingBearL2Level := lowestValidLow
        pendingBearL2BreakBar := bar_index
        pendingBullL2 := false

if enableRecursiveTransfer and bullRecursiveActive
    for transferStep = 0 to 20
        [hasOuterHigh, outerHigh, outerHighTime] = f_next_outer_high(bullRecursiveTime, bullRecursiveLevel)
        if bullRecursiveMoveCount < maxRecursiveTransfers and hasOuterHigh and close > outerHigh
            transferIsMSS = biasL2 == -1 or biasL2 == 0
            transferShouldShow = transferIsMSS ? showMSS : showBOS
            if not na(bullRecursiveLine)
                line.delete(bullRecursiveLine)
            bullRecursiveLine := na
            if showLevel2BOS and transferShouldShow
                bullRecursiveLine := line.new(outerHighTime, outerHigh, time, outerHigh, xloc=xloc.bar_time, color=bullColor, width=3)
            bullRecursiveLevel := outerHigh
            bullRecursiveTime := outerHighTime
            bullRecursiveMoveCount := bullRecursiveMoveCount + 1
            highestValidHigh := outerHigh
            highestValidHighTime := outerHighTime
            highestValidHighLine := outerHigh
            highestValidHighLineTime := outerHighTime
            highestValidHighBroken := true
            biasL2 := 1
            pendingBullL1 := false
            pendingBearL1 := false
            pendingBullL2 := true
            pendingBullL2WasMSS := transferIsMSS
            pendingBullL2BreakClose := close
            pendingBullL2Level := outerHigh
            pendingBullL2BreakBar := bar_index
            pendingBearL2 := false
        else
            break

if enableRecursiveTransfer and bearRecursiveActive
    for transferStep = 0 to 20
        [hasOuterLow, outerLow, outerLowTime] = f_next_outer_low(bearRecursiveTime, bearRecursiveLevel)
        if bearRecursiveMoveCount < maxRecursiveTransfers and hasOuterLow and close < outerLow
            transferIsMSS = biasL2 == 1 or biasL2 == 0
            transferShouldShow = transferIsMSS ? showMSS : showBOS
            if not na(bearRecursiveLine)
                line.delete(bearRecursiveLine)
            bearRecursiveLine := na
            if showLevel2BOS and transferShouldShow
                bearRecursiveLine := line.new(outerLowTime, outerLow, time, outerLow, xloc=xloc.bar_time, color=bearColor, width=3)
            bearRecursiveLevel := outerLow
            bearRecursiveTime := outerLowTime
            bearRecursiveMoveCount := bearRecursiveMoveCount + 1
            lowestValidLow := outerLow
            lowestValidLowTime := outerLowTime
            lowestValidLowLine := outerLow
            lowestValidLowLineTime := outerLowTime
            lowestValidLowBroken := true
            biasL2 := -1
            pendingBullL1 := false
            pendingBearL1 := false
            pendingBearL2 := true
            pendingBearL2WasMSS := transferIsMSS
            pendingBearL2BreakClose := close
            pendingBearL2Level := outerLow
            pendingBearL2BreakBar := bar_index
            pendingBullL2 := false
        else
            break
