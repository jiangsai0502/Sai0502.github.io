//@version=5
indicator("MGC 5m MSS/BOS 61.8 Auto Signal", overlay=true, max_lines_count=500, max_labels_count=500)

breakMode = input.string("Loose", "Break confirmation mode", options=["Loose", "Strict"])
webhookSecret = input.string("change-this-secret", "Webhook secret")
enableAlerts = input.bool(true, "Enable JSON alerts")
showLevels = input.bool(true, "Show wave levels")
showStructureBreaks = input.bool(true, "Show MSS/BOS structure lines")
showSwingLabels = input.bool(false, "Show confirmed ICT swing labels")

var float lastSwingHigh = na
var int lastSwingHighBar = na
var bool lastSwingHighBroken = true
var float bullWickExtreme = na

var float lastSwingLow = na
var int lastSwingLowBar = na
var bool lastSwingLowBroken = true
var float bearWickExtreme = na

var float candidateSwingHigh = na
var float candidateSwingHighLow = na
var int candidateSwingHighBar = na

var float candidateSwingLow = na
var float candidateSwingLowHigh = na
var int candidateSwingLowBar = na

var int bias = 0
var string activeDirection = ""
var float waveStart = na
var float waveEnd = na
var int waveStartBar = na
var line entryLine = na
var line slLine = na
var line tpLine = na

isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
newSwingHigh = false
newSwingLow = false

if not na(candidateSwingHigh) and bar_index > candidateSwingHighBar and low < candidateSwingHighLow
    lastSwingHigh := candidateSwingHigh
    lastSwingHighBar := candidateSwingHighBar
    lastSwingHighBroken := false
    bullWickExtreme := na
    newSwingHigh := true
    candidateSwingHigh := na
    candidateSwingHighLow := na
    candidateSwingHighBar := na

if not na(candidateSwingLow) and bar_index > candidateSwingLowBar and high > candidateSwingLowHigh
    lastSwingLow := candidateSwingLow
    lastSwingLowBar := candidateSwingLowBar
    lastSwingLowBroken := false
    bearWickExtreme := na
    newSwingLow := true
    candidateSwingLow := na
    candidateSwingLowHigh := na
    candidateSwingLowBar := na

if high > high[1]
    candidateSwingHigh := high
    candidateSwingHighLow := low
    candidateSwingHighBar := bar_index

if low < low[1]
    candidateSwingLow := low
    candidateSwingLowHigh := high
    candidateSwingLowBar := bar_index

if showSwingLabels and newSwingHigh
    label.new(lastSwingHighBar, lastSwingHigh, "SH", style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)

if showSwingLabels and newSwingLow
    label.new(lastSwingLowBar, lastSwingLow, "SL", style=label.style_label_up, color=color.new(color.lime, 70), textcolor=color.white, size=size.tiny)

isStrictBreakMode = breakMode == "Strict"
bullLooseBreak = not na(lastSwingHigh) and not lastSwingHighBroken and close > lastSwingHigh
bearLooseBreak = not na(lastSwingLow) and not lastSwingLowBroken and close < lastSwingLow
bullBreak = isStrictBreakMode ? bullLooseBreak and (na(bullWickExtreme) or close > bullWickExtreme) : bullLooseBreak
bearBreak = isStrictBreakMode ? bearLooseBreak and (na(bearWickExtreme) or close < bearWickExtreme) : bearLooseBreak

if not bullBreak and not na(lastSwingHigh) and not lastSwingHighBroken and high > lastSwingHigh
    bullWickExtreme := na(bullWickExtreme) ? high : math.max(bullWickExtreme, high)

if not bearBreak and not na(lastSwingLow) and not lastSwingLowBroken and low < lastSwingLow
    bearWickExtreme := na(bearWickExtreme) ? low : math.min(bearWickExtreme, low)

entryFor(_direction, _start, _end) =>
    _direction == "short" ? _end + (_start - _end) * 0.618 : _end - (_end - _start) * 0.618

jsonFor(_type, _kind, _direction, _start, _end, _startBar) =>
    _entry = entryFor(_direction, _start, _end)
    _sl = _start
    _tp = _end
    _waveId = _direction + ":" + str.tostring(_startBar)
    _id = syminfo.ticker + ":" + _waveId + ":" + str.tostring(time) + ":" + _type
    "{" +
      "\"secret\":\"" + webhookSecret + "\"," +
      "\"strategy\":\"mgc_5m_mss_618\"," +
      "\"type\":\"" + _type + "\"," +
      "\"kind\":\"" + _kind + "\"," +
      "\"id\":\"" + _id + "\"," +
      "\"ticker\":\"" + syminfo.ticker + "\"," +
      "\"interval\":\"" + timeframe.period + "\"," +
      "\"direction\":\"" + _direction + "\"," +
      "\"time\":" + str.tostring(timenow) + "," +
      "\"waveId\":\"" + _waveId + "\"," +
      "\"waveStartBar\":" + str.tostring(_startBar) + "," +
      "\"waveStart\":" + str.tostring(_start) + "," +
      "\"waveEnd\":" + str.tostring(_end) + "," +
      "\"entry\":" + str.tostring(_entry) + "," +
      "\"sl\":" + str.tostring(_sl) + "," +
      "\"tp\":" + str.tostring(_tp) +
      "}"

if bullBreak
    kind = bias == -1 or bias == 0 ? "MSS" : "BOS"
    lastSwingHighBroken := true
    bullWickExtreme := na
    bias := 1
    if not na(lastSwingLow)
        if showStructureBreaks
            line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=color.lime, width=2)
        activeDirection := "long"
        waveStart := lastSwingLow
        waveStartBar := lastSwingLowBar
        waveEnd := high
        if showLevels
            line.delete(entryLine)
            line.delete(slLine)
            line.delete(tpLine)
            _entry = entryFor(activeDirection, waveStart, waveEnd)
            entryLine := line.new(bar_index, _entry, bar_index + 20, _entry, color=color.yellow, extend=extend.right)
            slLine := line.new(bar_index, waveStart, bar_index + 20, waveStart, color=color.red, extend=extend.right)
            tpLine := line.new(bar_index, waveEnd, bar_index + 20, waveEnd, color=color.lime, extend=extend.right)
        if enableAlerts and isFiveMinute
            alert(jsonFor("structure", kind, activeDirection, waveStart, waveEnd, waveStartBar), alert.freq_once_per_bar_close)

if bearBreak
    kind = bias == 1 or bias == 0 ? "MSS" : "BOS"
    lastSwingLowBroken := true
    bearWickExtreme := na
    bias := -1
    if not na(lastSwingHigh)
        if showStructureBreaks
            line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=color.red, width=2)
        activeDirection := "short"
        waveStart := lastSwingHigh
        waveStartBar := lastSwingHighBar
        waveEnd := low
        if showLevels
            line.delete(entryLine)
            line.delete(slLine)
            line.delete(tpLine)
            _entry = entryFor(activeDirection, waveStart, waveEnd)
            entryLine := line.new(bar_index, _entry, bar_index + 20, _entry, color=color.yellow, extend=extend.right)
            slLine := line.new(bar_index, waveStart, bar_index + 20, waveStart, color=color.red, extend=extend.right)
            tpLine := line.new(bar_index, waveEnd, bar_index + 20, waveEnd, color=color.lime, extend=extend.right)
        if enableAlerts and isFiveMinute
            alert(jsonFor("structure", kind, activeDirection, waveStart, waveEnd, waveStartBar), alert.freq_once_per_bar_close)

longUpdate = activeDirection == "long" and not bullBreak and not bearBreak and not na(waveEnd) and high > waveEnd
shortUpdate = activeDirection == "short" and not bullBreak and not bearBreak and not na(waveEnd) and low < waveEnd

if longUpdate
    waveEnd := high
    if showLevels
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tpLine)
        _entry = entryFor(activeDirection, waveStart, waveEnd)
        entryLine := line.new(bar_index, _entry, bar_index + 20, _entry, color=color.yellow, extend=extend.right)
        slLine := line.new(bar_index, waveStart, bar_index + 20, waveStart, color=color.red, extend=extend.right)
        tpLine := line.new(bar_index, waveEnd, bar_index + 20, waveEnd, color=color.lime, extend=extend.right)
    if enableAlerts and isFiveMinute
        alert(jsonFor("wave_update", "EXTEND", activeDirection, waveStart, waveEnd, waveStartBar), alert.freq_once_per_bar_close)

if shortUpdate
    waveEnd := low
    if showLevels
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tpLine)
        _entry = entryFor(activeDirection, waveStart, waveEnd)
        entryLine := line.new(bar_index, _entry, bar_index + 20, _entry, color=color.yellow, extend=extend.right)
        slLine := line.new(bar_index, waveStart, bar_index + 20, waveStart, color=color.red, extend=extend.right)
        tpLine := line.new(bar_index, waveEnd, bar_index + 20, waveEnd, color=color.lime, extend=extend.right)
    if enableAlerts and isFiveMinute
        alert(jsonFor("wave_update", "EXTEND", activeDirection, waveStart, waveEnd, waveStartBar), alert.freq_once_per_bar_close)

plotchar(bullBreak and isFiveMinute, "Bull break", "▲", location.belowbar, color.lime)
plotchar(bearBreak and isFiveMinute, "Bear break", "▼", location.abovebar, color.red)
