//@version=5
indicator("MGC 5m MSS/BOS Alert + Order Plan", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

breakMode = input.string("Loose", "Break confirmation mode", options=["Loose", "Strict"])
showBOS = input.bool(true, "Show BOS when direction continues")
showMSS = input.bool(true, "Show MSS when direction shifts")
showSwingLevels = input.bool(false, "Show unbroken swing levels")
extendUnbrokenLevels = input.bool(true, "Extend unbroken swing levels")
showOnlyFiveMinuteWarning = input.bool(true, "Warn when chart is not 5m")
enableFiveMinuteAlerts = input.bool(true, "Enable 5m structure break alerts")
showSwingLabels = input.bool(false, "Show confirmed ICT swing labels")

showTradePlans = input.bool(true, "Show order plan boxes")
tradePlanBars = input.int(24, "Order plan width in bars", minval=5, maxval=200)
maxTradePlans = input.int(30, "Max visible order plans", minval=1, maxval=80)
showTradePlanLabels = input.bool(true, "Show order plan labels")

bullColor = input.color(color.lime, "Bullish break line color")
bearColor = input.color(color.red, "Bearish break line color")
swingHighColor = input.color(color.new(color.red, 65), "Unbroken swing high color")
swingLowColor = input.color(color.new(color.lime, 65), "Unbroken swing low color")
entryColor = input.color(color.yellow, "Order plan entry line color")
tpColor = input.color(color.lime, "Order plan TP line color")
slColor = input.color(color.red, "Order plan SL line color")
rewardFillColor = input.color(color.new(color.lime, 86), "Order plan reward fill")
riskFillColor = input.color(color.new(color.red, 86), "Order plan risk fill")

var float lastSwingHigh = na
var int lastSwingHighBar = na
var bool lastSwingHighBroken = true
var line lastSwingHighLine = na
var float bullWickExtreme = na

var float lastSwingLow = na
var int lastSwingLowBar = na
var bool lastSwingLowBroken = true
var line lastSwingLowLine = na
var float bearWickExtreme = na

var float candidateSwingHigh = na
var float candidateSwingHighLow = na
var int candidateSwingHighBar = na

var float candidateSwingLow = na
var float candidateSwingLowHigh = na
var int candidateSwingLowBar = na

var line[] tradePlanLines = array.new_line()
var box[] tradePlanBoxes = array.new_box()
var label[] tradePlanLabels = array.new_label()

// bias: 1 = bullish structure, -1 = bearish structure, 0 = not established yet.
var int bias = 0

isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
newSwingHigh = false
newSwingLow = false

entryFor(_direction, _start, _end) =>
    _direction == "short" ? _end + (_start - _end) * 0.618 : _end - (_end - _start) * 0.618

trimTradePlans() =>
    while array.size(tradePlanLines) > maxTradePlans * 3
        line.delete(array.shift(tradePlanLines))
    while array.size(tradePlanBoxes) > maxTradePlans * 2
        box.delete(array.shift(tradePlanBoxes))
    while array.size(tradePlanLabels) > maxTradePlans
        label.delete(array.shift(tradePlanLabels))

drawTradePlan(_direction, _kind, _start, _end, _startBar) =>
    _entry = entryFor(_direction, _start, _end)
    _sl = _start
    _tp = _end
    _rightBar = bar_index + tradePlanBars
    _isLong = _direction == "long"
    _rewardTop = _isLong ? _tp : _entry
    _rewardBottom = _isLong ? _entry : _tp
    _riskTop = _isLong ? _entry : _sl
    _riskBottom = _isLong ? _sl : _entry
    _risk = math.abs(_entry - _sl)
    _reward = math.abs(_tp - _entry)
    _rr = _risk > 0 ? _reward / _risk : na
    _rewardBox = box.new(bar_index, _rewardTop, _rightBar, _rewardBottom, border_color=color.new(tpColor, 35), bgcolor=rewardFillColor)
    _riskBox = box.new(bar_index, _riskTop, _rightBar, _riskBottom, border_color=color.new(slColor, 35), bgcolor=riskFillColor)
    _entryLine = line.new(bar_index, _entry, _rightBar, _entry, color=entryColor, width=2)
    _tpLine = line.new(bar_index, _tp, _rightBar, _tp, color=tpColor, width=1)
    _slLine = line.new(bar_index, _sl, _rightBar, _sl, color=slColor, width=1)
    array.push(tradePlanBoxes, _rewardBox)
    array.push(tradePlanBoxes, _riskBox)
    array.push(tradePlanLines, _entryLine)
    array.push(tradePlanLines, _tpLine)
    array.push(tradePlanLines, _slLine)
    if showTradePlanLabels
        _labelText = _kind + " " + str.upper(_direction) + "\nEntry " + str.tostring(_entry, format.mintick) + "\nTP " + str.tostring(_tp, format.mintick) + "\nSL " + str.tostring(_sl, format.mintick) + "\nRR " + str.tostring(_rr, "#.##")
        _label = label.new(_rightBar, _entry, _labelText, style=label.style_label_left, color=color.new(color.black, 10), textcolor=color.white, size=size.small)
        array.push(tradePlanLabels, _label)
    trimTradePlans()

if not na(candidateSwingHigh) and bar_index > candidateSwingHighBar and low < candidateSwingHighLow
    lastSwingHigh := candidateSwingHigh
    lastSwingHighBar := candidateSwingHighBar
    lastSwingHighBroken := false
    bullWickExtreme := na
    newSwingHigh := true
    candidateSwingHigh := na
    candidateSwingHighLow := na
    candidateSwingHighBar := na
    if showSwingLevels
        line.delete(lastSwingHighLine)
        lastSwingHighLine := line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=swingHighColor, width=1, style=line.style_dotted, extend=extendUnbrokenLevels ? extend.right : extend.none)

if not na(candidateSwingLow) and bar_index > candidateSwingLowBar and high > candidateSwingLowHigh
    lastSwingLow := candidateSwingLow
    lastSwingLowBar := candidateSwingLowBar
    lastSwingLowBroken := false
    bearWickExtreme := na
    newSwingLow := true
    candidateSwingLow := na
    candidateSwingLowHigh := na
    candidateSwingLowBar := na
    if showSwingLevels
        line.delete(lastSwingLowLine)
        lastSwingLowLine := line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=swingLowColor, width=1, style=line.style_dotted, extend=extendUnbrokenLevels ? extend.right : extend.none)

if high > high[1]
    candidateSwingHigh := high
    candidateSwingHighLow := low
    candidateSwingHighBar := bar_index

if low < low[1]
    candidateSwingLow := low
    candidateSwingLowHigh := high
    candidateSwingLowBar := bar_index

if showSwingLabels and newSwingHigh
    label.new(lastSwingHighBar, lastSwingHigh, "SH", style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)

if showSwingLabels and newSwingLow
    label.new(lastSwingLowBar, lastSwingLow, "SL", style=label.style_label_up, color=color.new(color.lime, 70), textcolor=color.white, size=size.tiny)

isStrictBreakMode = breakMode == "Strict"

bullLooseBreak = not na(lastSwingHigh) and not lastSwingHighBroken and close > lastSwingHigh
bearLooseBreak = not na(lastSwingLow) and not lastSwingLowBroken and close < lastSwingLow

bullBreak = isStrictBreakMode ? bullLooseBreak and (na(bullWickExtreme) or close > bullWickExtreme) : bullLooseBreak
bearBreak = isStrictBreakMode ? bearLooseBreak and (na(bearWickExtreme) or close < bearWickExtreme) : bearLooseBreak

if not bullBreak and not na(lastSwingHigh) and not lastSwingHighBroken and high > lastSwingHigh
    bullWickExtreme := na(bullWickExtreme) ? high : math.max(bullWickExtreme, high)

if not bearBreak and not na(lastSwingLow) and not lastSwingLowBroken and low < lastSwingLow
    bearWickExtreme := na(bearWickExtreme) ? low : math.min(bearWickExtreme, low)

bullWasMSS = bullBreak and (bias == -1 or bias == 0)
bearWasMSS = bearBreak and (bias == 1 or bias == 0)
fiveMinuteBullBreak = isFiveMinute and bullBreak
fiveMinuteBearBreak = isFiveMinute and bearBreak
fiveMinuteAnyBreak = fiveMinuteBullBreak or fiveMinuteBearBreak

if bullBreak
    isMSS = bias == -1 or bias == 0
    kind = isMSS ? "MSS" : "BOS"
    shouldShow = isMSS ? showMSS : showBOS
    lastSwingHighBroken := true
    bullWickExtreme := na
    bias := 1
    if showSwingLevels
        line.delete(lastSwingHighLine)
    if shouldShow
        line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=bullColor, width=2)
    if showTradePlans and shouldShow and not na(lastSwingLow)
        drawTradePlan("long", kind, lastSwingLow, high, lastSwingLowBar)

if bearBreak
    isMSS = bias == 1 or bias == 0
    kind = isMSS ? "MSS" : "BOS"
    shouldShow = isMSS ? showMSS : showBOS
    lastSwingLowBroken := true
    bearWickExtreme := na
    bias := -1
    if showSwingLevels
        line.delete(lastSwingLowLine)
    if shouldShow
        line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=bearColor, width=2)
    if showTradePlans and shouldShow and not na(lastSwingHigh)
        drawTradePlan("short", kind, lastSwingHigh, low, lastSwingHighBar)

if enableFiveMinuteAlerts and fiveMinuteBullBreak
    alert("5m bullish structure break confirmed by candle close.", alert.freq_once_per_bar_close)

if enableFiveMinuteAlerts and fiveMinuteBearBreak
    alert("5m bearish structure break confirmed by candle close.", alert.freq_once_per_bar_close)

alertcondition(bullBreak, "Bullish close-confirmed structure break", "Bullish structure break: candle closed above the latest confirmed swing high.")
alertcondition(bearBreak, "Bearish close-confirmed structure break", "Bearish structure break: candle closed below the latest confirmed swing low.")
alertcondition(fiveMinuteAnyBreak, "5m any structure break", "5m structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(fiveMinuteBullBreak, "5m bullish structure break", "5m bullish structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(fiveMinuteBearBreak, "5m bearish structure break", "5m bearish structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(bullWasMSS, "Bullish MSS", "Bullish MSS: candle closed above the latest confirmed swing high after bearish structure.")
alertcondition(bearWasMSS, "Bearish MSS", "Bearish MSS: candle closed below the latest confirmed swing low after bullish structure.")

var table warningTable = table.new(position.top_right, 1, 1)
if barstate.islast and showOnlyFiveMinuteWarning
    table.cell(warningTable, 0, 0, isFiveMinute ? "" : "Use on 5m chart", bgcolor=isFiveMinute ? color.new(color.black, 100) : color.new(color.orange, 0), text_color=color.white)
