//@version=5
indicator("H4前K高低点收盘突破提醒", overlay=true, max_lines_count=500, max_labels_count=500)

bufferTicks = input.int(2, "突破缓冲 tick 数", minval=0, tooltip="要求收盘价比前K高点/低点多突破几个最小跳动单位。实际缓冲价格 = tick数 * 当前品种最小跳动。设为0表示只要刚好收盘突破就算。")
minBodyAtr = input.float(0.0, "突破K最小实体 ATR 倍数", minval=0.0, step=0.05, tooltip="过滤实体太小的突破K。比如ATR=20，设置0.2，表示突破K实体至少要4点。设为0表示关闭这个过滤。")
showMarks = input.bool(true, "显示突破标记")
showAllBrokenLevels = input.bool(false, "显示所有被收盘突破的前K高/低点横线")
showStats = input.bool(true, "显示下一根延续统计")
statsPosition = input.string("右上", "统计表位置", options=["右上", "右下", "左上", "左下", "中上", "中下"])
statsTextSize = input.string("正常", "统计表字体大小", options=["很小", "小", "正常", "大"])

bullColor = input.color(color.lime, "多头颜色")
bearColor = input.color(color.red, "空头颜色")

f_table_position(positionText) =>
    switch positionText
        "右上" => position.top_right
        "右下" => position.bottom_right
        "左上" => position.top_left
        "左下" => position.bottom_left
        "中上" => position.top_center
        => position.bottom_center

f_text_size(sizeText) =>
    switch sizeText
        "很小" => size.tiny
        "小" => size.small
        "正常" => size.normal
        => size.large

buffer = syminfo.mintick * bufferTicks
barMs = int(timeframe.in_seconds(timeframe.period) * 1000)
lineEndTime = time + barMs
bodySize = math.abs(close - open)
atrValue = ta.atr(14)
bodyOk = minBodyAtr <= 0 or bodySize >= atrValue * minBodyAtr

bullBreak = barstate.isconfirmed and bodyOk and close > high[1] + buffer
bearBreak = barstate.isconfirmed and bodyOk and close < low[1] - buffer

var line latestBreakLine = na
var int lastDir = 0
var float lastSignalHigh = na
var float lastSignalLow = na
var int checkedSignals = 0
var int followedSignals = 0
var int followedNotStoppedSignals = 0

if barstate.isconfirmed and lastDir != 0
    bool followed = lastDir == 1 ? high > lastSignalHigh + buffer : low < lastSignalLow - buffer
    bool notStopped = lastDir == 1 ? low > lastSignalLow : high < lastSignalHigh
    checkedSignals := checkedSignals + 1
    if followed
        followedSignals := followedSignals + 1
        if notStopped
            followedNotStoppedSignals := followedNotStoppedSignals + 1
    lastDir := 0

if bullBreak
    if not showAllBrokenLevels and not na(latestBreakLine)
        line.delete(latestBreakLine)
    latestBreakLine := line.new(time[1], high[1], lineEndTime, high[1], xloc=xloc.bar_time, color=bullColor, width=2)
    lastDir := 1
    lastSignalHigh := high
    lastSignalLow := low

if bearBreak
    if not showAllBrokenLevels and not na(latestBreakLine)
        line.delete(latestBreakLine)
    latestBreakLine := line.new(time[1], low[1], lineEndTime, low[1], xloc=xloc.bar_time, color=bearColor, width=2)
    lastDir := -1
    lastSignalHigh := high
    lastSignalLow := low

if showMarks and bullBreak
    label.new(time, low, "收盘上破前K高点", xloc=xloc.bar_time, style=label.style_label_up, color=bullColor, textcolor=color.black, size=size.small)

if showMarks and bearBreak
    label.new(time, high, "收盘下破前K低点", xloc=xloc.bar_time, style=label.style_label_down, color=bearColor, textcolor=color.white, size=size.small)

if bullBreak
    alert("收盘上破前K高点: " + syminfo.ticker + " 收盘 " + str.tostring(close) + " > 前K高点 " + str.tostring(high[1]) + "。图表周期: " + timeframe.period, alert.freq_once_per_bar_close)

if bearBreak
    alert("收盘下破前K低点: " + syminfo.ticker + " 收盘 " + str.tostring(close) + " < 前K低点 " + str.tostring(low[1]) + "。图表周期: " + timeframe.period, alert.freq_once_per_bar_close)

var table statsTable = table.new(f_table_position(statsPosition), 2, 3)
var string activeStatsPosition = statsPosition
if activeStatsPosition != statsPosition
    table.delete(statsTable)
    statsTable := table.new(f_table_position(statsPosition), 2, 3)
    activeStatsPosition := statsPosition
if barstate.islast and showStats
    float followedRate = checkedSignals > 0 ? followedSignals * 100.0 / checkedSignals : na
    float notStoppedRate = checkedSignals > 0 ? followedNotStoppedSignals * 100.0 / checkedSignals : na
    textSize = f_text_size(statsTextSize)
    table.cell(statsTable, 0, 0, "已验证突破信号", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=textSize)
    table.cell(statsTable, 1, 0, str.tostring(checkedSignals), text_color=color.white, bgcolor=color.new(color.black, 0), text_size=textSize)
    table.cell(statsTable, 0, 1, "下一根延续成功", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=textSize)
    table.cell(statsTable, 1, 1, str.tostring(followedSignals) + " (" + (na(followedRate) ? "na" : str.tostring(followedRate, "#.##") + "%") + ")", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=textSize)
    table.cell(statsTable, 0, 2, "其中没被反向突破", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=textSize)
    table.cell(statsTable, 1, 2, str.tostring(followedNotStoppedSignals) + " (" + (na(notStoppedRate) ? "na" : str.tostring(notStoppedRate, "#.##") + "%") + ")", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=textSize)
