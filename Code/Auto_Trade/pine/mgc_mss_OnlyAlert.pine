//@version=5
indicator("MSS指标——App提醒功能", overlay=true, max_lines_count=500, max_labels_count=500)

breakMode = input.string("Loose", "Break confirmation mode", options=["Loose", "Strict"])
showBOS = input.bool(true, "Show BOS when direction continues")
showMSS = input.bool(true, "Show MSS when direction shifts")
showSwingLabels = input.bool(false, "Show confirmed ICT swing labels")

bullColor = input.color(color.lime, "Bullish break line color")
bearColor = input.color(color.red, "Bearish break line color")

var float lastSwingHigh = na
var int lastSwingHighBar = na
var bool lastSwingHighBroken = true
var float bullWickExtreme = na

var float lastSwingLow = na
var int lastSwingLowBar = na
var bool lastSwingLowBroken = true
var float bearWickExtreme = na

var float candidateSwingHigh = na
var float candidateSwingHighLow = na
var int candidateSwingHighBar = na

var float candidateSwingLow = na
var float candidateSwingLowHigh = na
var int candidateSwingLowBar = na

var bool pendingBullAlert = false
var bool pendingBullAlertWasMSS = false
var float pendingBullAlertBreakClose = na
var int pendingBullAlertBreakBar = na

var bool pendingBearAlert = false
var bool pendingBearAlertWasMSS = false
var float pendingBearAlertBreakClose = na
var int pendingBearAlertBreakBar = na

// bias: 1 = bullish structure, -1 = bearish structure, 0 = not established yet.
var int bias = 0

newSwingHigh = false
newSwingLow = false

if not na(candidateSwingHigh) and bar_index > candidateSwingHighBar and low < candidateSwingHighLow
    lastSwingHigh := candidateSwingHigh
    lastSwingHighBar := candidateSwingHighBar
    lastSwingHighBroken := false
    bullWickExtreme := na
    newSwingHigh := true
    candidateSwingHigh := na
    candidateSwingHighLow := na
    candidateSwingHighBar := na

if not na(candidateSwingLow) and bar_index > candidateSwingLowBar and high > candidateSwingLowHigh
    lastSwingLow := candidateSwingLow
    lastSwingLowBar := candidateSwingLowBar
    lastSwingLowBroken := false
    bearWickExtreme := na
    newSwingLow := true
    candidateSwingLow := na
    candidateSwingLowHigh := na
    candidateSwingLowBar := na

if high > high[1]
    candidateSwingHigh := high
    candidateSwingHighLow := low
    candidateSwingHighBar := bar_index

if low < low[1]
    candidateSwingLow := low
    candidateSwingLowHigh := high
    candidateSwingLowBar := bar_index

if showSwingLabels and newSwingHigh
    label.new(lastSwingHighBar, lastSwingHigh, "SH", style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)

if showSwingLabels and newSwingLow
    label.new(lastSwingLowBar, lastSwingLow, "SL", style=label.style_label_up, color=color.new(color.lime, 70), textcolor=color.white, size=size.tiny)

isStrictBreakMode = breakMode == "Strict"

bullLooseBreak = not na(lastSwingHigh) and not lastSwingHighBroken and close > lastSwingHigh
bearLooseBreak = not na(lastSwingLow) and not lastSwingLowBroken and close < lastSwingLow

bullBreak = isStrictBreakMode ? bullLooseBreak and (na(bullWickExtreme) or close > bullWickExtreme) : bullLooseBreak
bearBreak = isStrictBreakMode ? bearLooseBreak and (na(bearWickExtreme) or close < bearWickExtreme) : bearLooseBreak

if not bullBreak and not na(lastSwingHigh) and not lastSwingHighBroken and high > lastSwingHigh
    bullWickExtreme := na(bullWickExtreme) ? high : math.max(bullWickExtreme, high)

if not bearBreak and not na(lastSwingLow) and not lastSwingLowBroken and low < lastSwingLow
    bearWickExtreme := na(bearWickExtreme) ? low : math.min(bearWickExtreme, low)

bullWasMSS = bullBreak and (bias == -1 or bias == 0)
bearWasMSS = bearBreak and (bias == 1 or bias == 0)
delayStrictAlert = isStrictBreakMode

bullImmediateAlert = bullBreak and not delayStrictAlert
bearImmediateAlert = bearBreak and not delayStrictAlert

bullDeferredAlert = delayStrictAlert and pendingBullAlert and newSwingHigh and bar_index > pendingBullAlertBreakBar
bearDeferredAlert = delayStrictAlert and pendingBearAlert and newSwingLow and bar_index > pendingBearAlertBreakBar

bullDeferredAlertWasMSS = pendingBullAlertWasMSS
bearDeferredAlertWasMSS = pendingBearAlertWasMSS
bullDeferredAlertBreakClose = pendingBullAlertBreakClose
bearDeferredAlertBreakClose = pendingBearAlertBreakClose

alertBullBreak = bullImmediateAlert or bullDeferredAlert
alertBearBreak = bearImmediateAlert or bearDeferredAlert
alertAnyBreak = alertBullBreak or alertBearBreak
alertBullMSS = bullImmediateAlert ? bullWasMSS : bullDeferredAlert and bullDeferredAlertWasMSS
alertBearMSS = bearImmediateAlert ? bearWasMSS : bearDeferredAlert and bearDeferredAlertWasMSS

if bullDeferredAlert
    pendingBullAlert := false
    pendingBullAlertWasMSS := false
    pendingBullAlertBreakClose := na
    pendingBullAlertBreakBar := na

if bearDeferredAlert
    pendingBearAlert := false
    pendingBearAlertWasMSS := false
    pendingBearAlertBreakClose := na
    pendingBearAlertBreakBar := na

if bullBreak
    isMSS = bias == -1 or bias == 0
    shouldShow = isMSS ? showMSS : showBOS
    lastSwingHighBroken := true
    bullWickExtreme := na
    bias := 1
    if shouldShow
        line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=bullColor, width=2)
    if delayStrictAlert
        pendingBullAlert := true
        pendingBullAlertWasMSS := isMSS
        pendingBullAlertBreakClose := close
        pendingBullAlertBreakBar := bar_index
        pendingBearAlert := false

if bearBreak
    isMSS = bias == 1 or bias == 0
    shouldShow = isMSS ? showMSS : showBOS
    lastSwingLowBroken := true
    bearWickExtreme := na
    bias := -1
    if shouldShow
        line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=bearColor, width=2)
    if delayStrictAlert
        pendingBearAlert := true
        pendingBearAlertWasMSS := isMSS
        pendingBearAlertBreakClose := close
        pendingBearAlertBreakBar := bar_index
        pendingBullAlert := false

if alertBullBreak
    wasMSS = bullImmediateAlert ? bullWasMSS : bullDeferredAlertWasMSS
    breakClose = bullImmediateAlert ? close : bullDeferredAlertBreakClose
    msg = (wasMSS ? "Bullish MSS" : "Bullish BOS") + " on " + syminfo.ticker + ". Break close: " + str.tostring(breakClose) + ". Current close: " + str.tostring(close) + ". Timeframe: " + timeframe.period + "."
    if bullDeferredAlert
        alert(msg, alert.freq_once_per_bar)
    else
        alert(msg, alert.freq_once_per_bar_close)

if alertBearBreak
    wasMSS = bearImmediateAlert ? bearWasMSS : bearDeferredAlertWasMSS
    breakClose = bearImmediateAlert ? close : bearDeferredAlertBreakClose
    msg = (wasMSS ? "Bearish MSS" : "Bearish BOS") + " on " + syminfo.ticker + ". Break close: " + str.tostring(breakClose) + ". Current close: " + str.tostring(close) + ". Timeframe: " + timeframe.period + "."
    if bearDeferredAlert
        alert(msg, alert.freq_once_per_bar)
    else
        alert(msg, alert.freq_once_per_bar_close)

alertcondition(alertAnyBreak, "Any structure break", "Structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBullBreak, "Bullish structure break", "Bullish structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBearBreak, "Bearish structure break", "Bearish structure break on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBullMSS, "Bullish MSS", "Bullish MSS on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
alertcondition(alertBearMSS, "Bearish MSS", "Bearish MSS on {{ticker}}. Close: {{close}}. Timeframe: {{interval}}.")
